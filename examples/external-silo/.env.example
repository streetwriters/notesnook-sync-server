# Merge these into the repository root .env (see /.env for all other variables).
#
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD must match examples/external-silo/infra.env.example
# when starting the external Silo infra stack. Silo uses MINIO_* names for compatibility.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
